# ============================================================
# 环境变量示例文件（可以安全提交到 GitHub，因为这里没有真实密钥）
# 用法：把这个文件复制成 .env，再把真实的 Key 填进去。
#   复制命令： cp .env.example .env
# .env 已经被 .gitignore 忽略，不会上传到 GitHub。
# ============================================================

# 用哪家 LLM：anthropic（默认，Claude）或 ark（火山方舟）。
# 切换厂商只改这一行 + 对应的 Key/模型名，业务代码不用动。
LLM_PROVIDER=anthropic

# —— provider=anthropic 时用这个 ——
# 【必填】Anthropic（Claude）API Key，去 https://console.anthropic.com 申请。
# 一个 Key 同时能调用 Haiku（初筛）和 Sonnet（分析）两个模型。
ANTHROPIC_API_KEY=

# —— provider=ark（火山方舟）时用这个（现在可留空）——
# 需先 pip install openai。Key 去火山方舟控制台拿。
ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3   # 一般不用改

# 【可选】模型名称。不填就用代码里的默认值。
# provider=anthropic 默认：claude-haiku-4-5 / claude-sonnet-4-6
# provider=ark 时请填火山的模型名或接入点ID，例如 doubao-lite-... / doubao-seed-...
LLM_SCREENING_MODEL=claude-haiku-4-5     # 初筛：便宜、快
LLM_ANALYSIS_MODEL=claude-sonnet-4-6     # 深度分析：质量好

# ============================================================
# 飞书集成（可选）。两套相互独立的机制：
#   1) 群机器人 Webhook —— 推送精选报告（只需一个 URL，无需建应用）
#   2) 电子表格审计日志 —— 每次跑完把所有处理过的 episode 追加进表格（需自建应用）
# ============================================================

# —— 1) 群机器人 Webhook：飞书群「设置 → 群机器人 → 添加自定义机器人」获取 ——
FEISHU_WEBHOOK_URL=

# —— 2) 电子表格审计日志（src/integrations/feishu_sheet.py）——
# 开关：填 true 才会写表格；默认 false。
FEISHU_SHEET_ENABLED=false
# API 域名：飞书(中国)留空即可（默认 open.feishu.cn）；
# 若你的应用在 Lark 国际版（webhook 在 larkoffice/larksuite），填 https://open.larksuite.com。
FEISHU_API_BASE=
# 飞书开放平台「自建应用」凭证：https://open.feishu.cn → 开发者后台 → 创建企业自建应用。
# 该应用需开通「电子表格」读写权限，并被加为目标表格的协作者（可编辑）。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 目标表格定位，从表格 URL 里取：
#   https://xxx.feishu.cn/sheets/<SPREADSHEET_TOKEN>?sheet=<SHEET_ID>
FEISHU_SHEET_SPREADSHEET_TOKEN=
FEISHU_SHEET_SHEET_ID=
